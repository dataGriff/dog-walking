### Dog Walking API - Local HTTP Requests
### Prerequisites: install the VS Code REST Client extension
### Start the API first: task api:dev

@baseUrl = http://localhost:3000/v1

# =============================================================================
# 1. AUTH
# =============================================================================

### 1a. Register a walker
# @name registerWalker
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "jane.walker@example.com",
  "password": "password123",
  "firstName": "Jane",
  "lastName": "Walker",
  "role": "walker"
}

###
@walkerToken = {{registerWalker.response.body.accessToken}}

### 1b. Register an owner
# @name registerOwner
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "john.owner@example.com",
  "password": "password123",
  "firstName": "John",
  "lastName": "Owner",
  "role": "owner"
}

###
@ownerToken = {{registerOwner.response.body.accessToken}}

### 1c. Login as walker
# @name loginWalker
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "jane.walker@example.com",
  "password": "password123"
}

### 1d. Refresh token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{loginWalker.response.body.refreshToken}}"
}

### 1e. Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{walkerToken}}

# =============================================================================
# 2. INTEREST REQUESTS (public — no auth required)
# =============================================================================

### 2a. Submit an interest request (public)
# @name submitInterest
POST {{baseUrl}}/interest-requests
Content-Type: application/json

{
  "firstName": "Sarah",
  "lastName": "Davies",
  "email": "sarah.davies@example.com",
  "phone": "+44 7700 900789",
  "postcode": "CF10 1AB",
  "dogDescription": "A friendly 3-year-old Labrador called Buddy."
}

###
@interestRequestId = {{submitInterest.response.body.id}}

### 2b. List interest requests (walker only)
GET {{baseUrl}}/interest-requests
Authorization: Bearer {{walkerToken}}

### 2c. Get a single interest request (walker only)
GET {{baseUrl}}/interest-requests/{{interestRequestId}}
Authorization: Bearer {{walkerToken}}

### 2d. Accept an interest request (walker only)
POST {{baseUrl}}/interest-requests/{{interestRequestId}}/accept
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "notes": "Looking forward to meeting Buddy!"
}

### 2e. Decline an interest request (walker only)
# POST {{baseUrl}}/interest-requests/{{interestRequestId}}/decline
# Authorization: Bearer {{walkerToken}}
# Content-Type: application/json
#
# {
#   "declineReason": "Not currently covering the CF5 area."
# }

# =============================================================================
# 3. OWNERS
# =============================================================================

### 3a. Create an owner (walker only)
# @name createOwner
POST {{baseUrl}}/owners
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Owner",
  "email": "john.owner2@example.com",
  "phone": "02920123456"
}

###
@ownerId = {{createOwner.response.body.id}}

### 3b. List owners (walker only)
GET {{baseUrl}}/owners
Authorization: Bearer {{walkerToken}}

### 3c. Get a single owner
GET {{baseUrl}}/owners/{{ownerId}}
Authorization: Bearer {{walkerToken}}

### 3d. Update an owner
PUT {{baseUrl}}/owners/{{ownerId}}
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Owner",
  "email": "john.owner2@example.com",
  "phone": "02920999888"
}

# =============================================================================
# 4. WALKERS
# =============================================================================

### 4a. Create a walker (walker only)
# @name createWalker
POST {{baseUrl}}/walkers
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Walker",
  "email": "jane.walker2@example.com",
  "phone": "02920111222"
}

###
@walkerId = {{createWalker.response.body.id}}

### 4b. List walkers
GET {{baseUrl}}/walkers
Authorization: Bearer {{walkerToken}}

### 4c. Get a single walker
GET {{baseUrl}}/walkers/{{walkerId}}
Authorization: Bearer {{walkerToken}}

# =============================================================================
# 5. DOGS
# =============================================================================

### 5a. Add a dog to an owner
# @name createDog
POST {{baseUrl}}/owners/{{ownerId}}/dogs
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "name": "Buddy",
  "breed": "Labrador",
  "dateOfBirth": "2022-03-15"
}

###
@dogId = {{createDog.response.body.id}}

### 5b. List dogs for an owner
GET {{baseUrl}}/owners/{{ownerId}}/dogs
Authorization: Bearer {{walkerToken}}

### 5c. Get a single dog
GET {{baseUrl}}/owners/{{ownerId}}/dogs/{{dogId}}
Authorization: Bearer {{walkerToken}}

# =============================================================================
# 6. WALK REQUESTS
# =============================================================================

### 6a. Submit a walk request
# @name createWalkRequest
POST {{baseUrl}}/walk-requests
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "ownerId": "{{ownerId}}",
  "dogIds": ["{{dogId}}"],
  "requestedDate": "2026-05-01",
  "requestedStartTime": "09:00:00Z",
  "durationMinutes": 60,
  "walkType": "solo_walk",
  "notes": "Buddy needs his morning walk."
}

###
@walkRequestId = {{createWalkRequest.response.body.id}}

### 6b. List walk requests
GET {{baseUrl}}/walk-requests
Authorization: Bearer {{walkerToken}}

### 6c. Get a single walk request
GET {{baseUrl}}/walk-requests/{{walkRequestId}}
Authorization: Bearer {{walkerToken}}

### 6d. Accept a walk request (creates a Walk)
# @name acceptWalkRequest
POST {{baseUrl}}/walk-requests/{{walkRequestId}}/accept
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "walkerId": "{{walkerId}}",
  "confirmedDate": "2026-05-01",
  "confirmedStartTime": "09:00:00Z",
  "notes": "Will pick up from the front door."
}

###
@walkId = {{acceptWalkRequest.response.body.id}}

### 6e. Decline a walk request
# POST {{baseUrl}}/walk-requests/{{walkRequestId}}/decline
# Authorization: Bearer {{walkerToken}}
# Content-Type: application/json
#
# {
#   "declineReason": "Fully booked that day."
# }

# =============================================================================
# 7. WALKS
# =============================================================================

### 7a. List walks
GET {{baseUrl}}/walks
Authorization: Bearer {{walkerToken}}

### 7b. Get a single walk
GET {{baseUrl}}/walks/{{walkId}}
Authorization: Bearer {{walkerToken}}

### 7c. Start a walk
POST {{baseUrl}}/walks/{{walkId}}/start
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{}

### 7d. Post a walk update (note)
# @name postWalkUpdate
POST {{baseUrl}}/walks/{{walkId}}/updates
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "type": "note",
  "note": "Buddy is doing great — just passing Bute Park!"
}

### 7e. List walk updates
GET {{baseUrl}}/walks/{{walkId}}/updates
Authorization: Bearer {{walkerToken}}

### 7f. Complete a walk
POST {{baseUrl}}/walks/{{walkId}}/complete
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "actualStartTime": "09:05",
  "actualEndTime": "10:10",
  "distanceKm": 4.2,
  "summaryNotes": "Great walk — Buddy was very energetic today!"
}

### 7g. Cancel a walk
# POST {{baseUrl}}/walks/{{walkId}}/cancel
# Authorization: Bearer {{walkerToken}}
# Content-Type: application/json
#
# {
#   "cancelReason": "Owner requested cancellation."
# }

# =============================================================================
# 8. RECURRING WALKS
# =============================================================================

### 8a. Create a recurring walk
# @name createRecurringWalk
POST {{baseUrl}}/recurring-walks
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "ownerId": "{{ownerId}}",
  "dogIds": ["{{dogId}}"],
  "walkType": "solo_walk",
  "durationMinutes": 60,
  "recurrence": {
    "frequency": "weekly",
    "dayOfWeek": "Monday",
    "startTime": "09:00:00Z"
  },
  "startDate": "2026-05-05"
}

###
@recurringWalkId = {{createRecurringWalk.response.body.id}}

### 8b. List recurring walks
GET {{baseUrl}}/recurring-walks
Authorization: Bearer {{walkerToken}}

### 8c. Get a single recurring walk
GET {{baseUrl}}/recurring-walks/{{recurringWalkId}}
Authorization: Bearer {{walkerToken}}

### 8d. Pause a recurring walk
POST {{baseUrl}}/recurring-walks/{{recurringWalkId}}/pause
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{}

### 8e. Resume a recurring walk
POST {{baseUrl}}/recurring-walks/{{recurringWalkId}}/resume
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{}

# =============================================================================
# 9. INVOICES
# =============================================================================

### 9a. Create an invoice
# @name createInvoice
POST {{baseUrl}}/invoices
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "ownerId": "{{ownerId}}",
  "walkerId": "{{walkerId}}",
  "lineItems": [
    {
      "walkId": "{{walkId}}",
      "description": "Solo walk 60min — 2026-05-01",
      "quantity": 1,
      "unitPrice": 15.00
    }
  ],
  "dueDate": "2026-05-15"
}

###
@invoiceId = {{createInvoice.response.body.id}}

### 9b. List invoices
GET {{baseUrl}}/invoices
Authorization: Bearer {{walkerToken}}

### 9c. Get a single invoice
GET {{baseUrl}}/invoices/{{invoiceId}}
Authorization: Bearer {{walkerToken}}

### 9d. Send an invoice to the owner
POST {{baseUrl}}/invoices/{{invoiceId}}/send
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{}

### 9e. Mark an invoice as paid
POST {{baseUrl}}/invoices/{{invoiceId}}/mark-paid
Authorization: Bearer {{walkerToken}}
Content-Type: application/json

{
  "paymentMethod": "bank_transfer",
  "paymentReference": "REF-2026-001",
  "paidAt": "2026-05-10T14:00:00Z"
}
