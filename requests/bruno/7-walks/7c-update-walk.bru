meta {
  name: Update Walk
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/walks/{{walkId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{walkerToken}}
}

body:json {
  {
    "scheduledDate": "2026-05-01",
    "scheduledStartTime": "09:30:00Z",
    "durationMinutes": 60,
    "routeNotes": "Use the river path today."
  }
}
