meta {
  name: Update Owner
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/owners/{{ownerId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{walkerToken}}
}

body:json {
  {
    "firstName": "John",
    "lastName": "Owner",
    "email": "john.owner2@example.com",
    "phone": "02920999888"
  }
}
