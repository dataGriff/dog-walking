meta {
  name: Update Walker
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/walkers/{{walkerId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{walkerToken}}
}

body:json {
  {
    "firstName": "Jane",
    "lastName": "Walker",
    "email": "jane.walker2@example.com",
    "phone": "02920999111",
    "bio": "Experienced dog walker covering Cardiff city centre."
  }
}
