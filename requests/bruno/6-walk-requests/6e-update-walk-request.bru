meta {
  name: Update Walk Request
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/walk-requests/{{walkRequestId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{walkerToken}}
}

body:json {
  {
    "ownerId": "{{ownerId}}",
    "dogIds": ["{{dogId}}"],
    "requestedDate": "2026-05-02",
    "requestedStartTime": "10:00:00Z",
    "durationMinutes": 60,
    "walkType": "solo_walk"
  }
}
