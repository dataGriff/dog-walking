meta {
  name: Accept Walk Request
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/walk-requests/{{walkRequestId}}/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{walkerToken}}
}

body:json {
  {
    "walkerId": "{{walkerId}}",
    "confirmedDate": "2026-05-01",
    "confirmedStartTime": "09:00:00Z",
    "notes": "Will pick up from the front door."
  }
}

script:post-response {
  bru.setVar("walkId", res.getBody().id);
}
