meta {
  name: Create Invoice
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/invoices
  body: json
  auth: bearer
}

auth:bearer {
  token: {{walkerToken}}
}

body:json {
  {
    "ownerId": "{{ownerId}}",
    "walkerId": "{{walkerId}}",
    "lineItems": [
      {
        "walkId": "{{walkId}}",
        "description": "Solo walk 60min — 2026-05-01",
        "quantity": 1,
        "unitPrice": 15.00
      }
    ],
    "dueDate": "2026-05-15"
  }
}

script:post-response {
  bru.setVar("invoiceId", res.getBody().id);
}
