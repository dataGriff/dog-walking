meta {
  name: Mark Invoice As Paid
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/invoices/{{invoiceId}}/mark-paid
  body: json
  auth: bearer
}

auth:bearer {
  token: {{walkerToken}}
}

body:json {
  {
    "paymentMethod": "bank_transfer",
    "paymentReference": "REF-2026-001",
    "paidAt": "2026-05-10T14:00:00Z"
  }
}
